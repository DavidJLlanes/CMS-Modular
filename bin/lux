#!/usr/bin/env php
<?php
declare(strict_types=1);

use LuxAeterna\Core\Autoloader;
use LuxAeterna\Admin\Services;
use LuxAeterna\Core\Config;
use LuxAeterna\Core\Doctor;
use LuxAeterna\Core\Installer;
use LuxAeterna\Core\Logger;
use LuxAeterna\Core\LuxException;
use LuxAeterna\Core\Operation;
use LuxAeterna\Publishing\Activator;
use LuxAeterna\Publishing\Publisher;
use LuxAeterna\Publishing\ReleaseStore;

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit;
}
if (version_compare(PHP_VERSION, '8.1.0', '<')) {
    fwrite(STDERR, "LuxAeterna requiere PHP 8.1 o superior (actual: " . PHP_VERSION . ").\n");
    exit(1);
}

$root = dirname(__DIR__);
require $root . '/src/Core/Autoloader.php';
Autoloader::register($root . '/src');

const USAGE = <<<TXT
Uso: bin/lux <comando> [opciones]

  doctor [--json] [--http]       Diagnóstico del entorno (--http comprueba que var/ no se sirve)
  install --url=https://dominio  Crea configuración y directorios (--force regenera la configuración)
  publish [--force] [--queue] [--content=ARCHIVO|--demo]
                                 Genera y activa una versión con el contenido publicado en el panel
                                 (si no hay ninguno, el sitio de demostración)
  releases                       Lista las versiones y marca la activa
  designs[:refresh]              Diseños detectados en components/ (y errores de contrato)
  fonts[:check] | fonts:add <Familia> --license=OFL-1.1 [--weights=400,700] [--category=sans-serif]
  design:show | design:set ARCHIVO.json   Ver o sustituir los ajustes de diseño (incluye niveles por página)
  resources [--path=/ruta/]      Inventario de recursos de la versión activa
  jobs                           Últimos trabajos de publicación
  jobs:run                       Ejecuta los trabajos pendientes (para cron)
  rollback <id>                  Reactiva una versión anterior
  migrate                        Aplica las migraciones de base de datos pendientes
  admin:create <correo> [--role=admin|editor] [--name=Nombre]
                                 Crea una cuenta e imprime el enlace de alta (60 min, un solo uso)
  admin:list                     Lista las cuentas
  admin:reset <correo>           Imprime un enlace de recuperación de contraseña (30 min, un solo uso)
  admin:mfa-reset <correo>       Desactiva el segundo factor (se vuelve a configurar al entrar)
  admin:revoke-sessions <correo>|--all
                                 Cierra las sesiones abiertas
  admin:disable <correo>         Desactiva la cuenta y cierra sus sesiones
  admin:enable <correo>          Reactiva la cuenta
  admin:role <correo> <rol>      Cambia el rol (admin|editor)
  version                        Muestra la versión

TXT;

/** @return array{0:list<string>,1:array<string,string|true>} */
function parseArgs(array $argv): array
{
    $pos = [];
    $opts = [];
    foreach (array_slice($argv, 1) as $a) {
        if (str_starts_with($a, '--')) {
            $kv = explode('=', substr($a, 2), 2);
            $opts[$kv[0]] = $kv[1] ?? true;
        } else {
            $pos[] = $a;
        }
    }
    return [$pos, $opts];
}

function logger(string $root): Logger
{
    try {
        return new Logger(Config::load($root)->path('data') . '/logs');
    } catch (Throwable) {
        return new Logger($root . '/var/logs');
    }
}

function store(Config $c): ReleaseStore
{
    return new ReleaseStore($c->path('publish'));
}

[$pos, $opts] = parseArgs($argv);
$cmd = $pos[0] ?? 'help';

/** Evita crear archivos de root dentro de var/ (el pool de PHP-FPM, otro usuario, dejaría de poder escribirlos). */
function guardUser(string $root, string $cmd): void
{
    if (in_array($cmd, ['doctor', 'version', 'help'], true) || !function_exists('posix_geteuid') || posix_geteuid() !== 0) {
        return;
    }
    try {
        $dataOwner = @fileowner(Config::load($root)->path('data'));
    } catch (Throwable) {
        return;
    }
    if (is_int($dataOwner) && $dataOwner !== 0) {
        $name = (function_exists('posix_getpwuid') ? (posix_getpwuid($dataOwner)['name'] ?? '') : '') ?: 'el propietario de var/';
        throw new LuxException("Ejecuta este comando como $name, no como root: runuser -u $name -- php bin/lux $cmd ...");
    }
}

function services(string $root, bool $migrate = false): Services
{
    return new Services(Config::load($root), $migrate);
}

function userByEmail(Services $sv, string $email): array
{
    $u = $sv->users->byEmail($email);
    if ($u === null) {
        throw new LuxException('No existe ninguna cuenta con ese correo.');
    }
    return $u;
}

function enrollLink(Services $sv, array $u, string $purpose): string
{
    $path = $purpose === 'setup' ? '/admin/setup' : '/admin/reset';
    return $sv->config->baseUrl() . $path . '?token=' . $sv->tokens->create((int)$u['id'], $purpose);
}

try {
    guardUser($root, $cmd);
    switch ($cmd) {
        case 'version':
            echo "LuxAeterna " . \LuxAeterna\Core\Version::LABEL . "\n";
            break;

        case 'doctor':
            try {
                $config = Config::load($root);
            } catch (LuxException) {
                $config = null;
            }
            $results = (new Doctor($root, $config))->run(isset($opts['http']));
            if (isset($opts['json'])) {
                echo json_encode($results, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE), "\n";
            } else {
                $icons = ['ok' => 'OK   ', 'warn' => 'AVISO', 'fail' => 'ERROR'];
                foreach ($results as $r) {
                    printf("[%s] %-12s %s\n", $icons[$r['level']], $r['name'], $r['message']);
                }
            }
            exit(Doctor::exitCode($results));

        case 'install':
            $url = $opts['url'] ?? null;
            if (!is_string($url)) {
                throw new LuxException('Indica la URL pública: bin/lux install --url=https://tu-dominio');
            }
            foreach ((new Installer($root))->install($url, isset($opts['force'])) as $line) {
                echo "- $line\n";
            }
            $results = (new Doctor($root, Config::load($root)))->run();
            $fails = array_filter($results, static fn(array $r): bool => $r['level'] === 'fail');
            echo $fails === [] ? "Instalación correcta. Ejecuta bin/lux doctor para el detalle.\n" : "Instalación con errores; ejecuta bin/lux doctor.\n";
            exit($fails === [] ? 0 : 1);

        case 'publish':
            $config = Config::load($root);
            $layout = $root . '/components/layouts/base';
            $publisher = new Publisher($config, store($config), logger($root), $layout);
            $force = isset($opts['force']);
            if (is_string($opts['content'] ?? null) || isset($opts['demo'])) {
                $content = is_string($opts['content'] ?? null) ? $opts['content'] : $root . '/examples/sitio-demo/content.json';
                $res = $publisher->publish($content, $force);
            } else {
                $sv = new Services($config, true);
                if (!$sv->site->hasPublished()) {
                    echo "No hay contenido publicado en el panel: se publica el sitio de demostración.\n";
                    $res = $publisher->publish($root . '/examples/sitio-demo/content.json', $force);
                } else {
                    $svc = $sv->publishing();
                    $jid = $svc->enqueuePublish('cli', null, 'bin/lux publish', $force);
                    if (isset($opts['queue'])) {
                        echo "Trabajo #$jid en cola (se ejecuta con: bin/lux jobs:run).\n";
                        break;
                    }
                    $job = $svc->runNext($jid) ?? $sv->jobs()->get($jid);
                    foreach ($sv->jobs()->logs($jid) as $l) {
                        echo '  [' . $l['level'] . '] ' . $l['message'] . "\n";
                    }
                    if ($job['status'] === 'queued') {
                        echo "El trabajo #$jid quedó en espera (reintento automático con jobs:run).\n";
                        exit(2);
                    }
                    if ($job['status'] !== 'succeeded') {
                        fwrite(STDERR, "Publicación fallida: {$job['error']}\n");
                        exit(1);
                    }
                    echo $job['skipped'] ? "Sin cambios: la versión activa {$job['release_id']} ya está al día (usa --force para regenerar).\n" : "Publicada la versión {$job['release_id']}.\n";
                    $sv->audit->log('site.publish', null, 'cli', null, ['release' => $job['release_id'], 'job' => $jid]);
                    break;
                }
            }
            echo "Publicada la versión {$res['id']} ({$res['pages']} páginas, activación: {$res['strategy']}).\n";
            foreach ($res['warnings'] as $w) {
                echo "  Aviso: $w\n";
            }
            if ($res['removed'] !== []) {
                echo 'Versiones antiguas eliminadas: ' . implode(', ', $res['removed']) . "\n";
            }
            break;

        case 'jobs':
            $sv = services($root, true);
            foreach (array_reverse($sv->jobs()->recent((int)($opts['limit'] ?? 15))) as $j) {
                printf("#%d %-9s %-8s %-8s intentos %d/%d %s%s\n", $j['id'], $j['status'], $j['kind'], $j['source'], $j['attempts'], $j['max_attempts'], (string)($j['release_id'] ?? ''), $j['error'] ? '  ! ' . $j['error'] : '');
            }
            break;

        case 'jobs:run':
            $sv = services($root, true);
            $n = $sv->publishing()->runAll();
            echo "Trabajos procesados: $n\n";
            break;

        case 'releases':
            $sv = services($root, true);
            $store = $sv->releaseStore();
            $cur = $store->currentId();
            foreach (array_reverse($store->all()) as $id) {
                $m = $store->meta($id) ?? [];
                echo ($id === $cur ? '* ' : '  ') . $id . '  ' . ($m['pages'] ?? '?') . ' páginas  ' . ($m['created'] ?? '') . "\n";
            }
            if ($store->all() === []) {
                echo "No hay versiones.\n";
            }
            break;

        case 'rollback':
            $id = $pos[1] ?? '';
            $sv = services($root, true);
            $svc = $sv->publishing();
            $job = $svc->runNext($svc->enqueueRollback($id, 'cli', null, 'bin/lux rollback'));
            foreach ($sv->jobs()->logs((int)$job['id']) as $l) {
                echo '  [' . $l['level'] . '] ' . $l['message'] . "\n";
            }
            if ($job['status'] !== 'succeeded') {
                fwrite(STDERR, "Reversión fallida: {$job['error']}\n");
                exit(1);
            }
            $sv->audit->log('site.rollback', null, 'cli', null, ['release' => $id]);
            echo "Versión $id activada.\n";
            break;

        case 'designs':
        case 'designs:refresh':
            $config = Config::load($root);
            $reg = new \LuxAeterna\Design\DesignRegistry($root . '/components', $config->path('data') . '/cache/designs.json', \LuxAeterna\Core\Version::CURRENT);
            $idx = $cmd === 'designs:refresh' ? $reg->refresh() : $reg->index();
            foreach ($idx['designs'] as $d) {
                printf("%-18s %-8s v%-7s %s  (%s)\n", $d['id'], $d['type'], $d['version'], $d['name'], $d['dir']);
            }
            foreach ($idx['errors'] as $e) {
                fwrite(STDERR, "  ! {$e['dir']}: {$e['message']}\n");
            }
            echo count($idx['designs']) . ' diseños válidos, ' . count($idx['errors']) . " con errores.\n";
            exit($idx['errors'] === [] ? 0 : 1);

        case 'fonts':
        case 'fonts:check':
            $cat = new \LuxAeterna\Design\FontCatalog($root . '/components/fonts');
            foreach ($cat->all() as $f) {
                printf("%-18s %-11s %-9s %d variantes  faltan: %s\n", $f['slug'], $f['category'], $f['license'], count($f['variants']), implode('', $cat->missingChars($f['slug'], ['es'])) ?: 'ninguno');
            }
            $bad = $cat->problems();
            foreach ($bad as $b) {
                fwrite(STDERR, "  ! $b\n");
            }
            exit($bad === [] ? 0 : 1);

        case 'fonts:add':
            $fam = $pos[1] ?? '';
            $w = array_values(array_filter(array_map('intval', explode(',', (string)($opts['weights'] ?? '400,700')))));
            $slug = (new \LuxAeterna\Design\FontCatalog($root . '/components/fonts'))->importFromGoogle($fam, $w, (string)($opts['license'] ?? ''), (string)($opts['category'] ?? 'sans-serif'));
            echo "Fuente añadida al catálogo local: $slug. Revisa la licencia en components/fonts/$slug/.\n";
            break;

        case 'resources':
            $config = Config::load($root);
            $f = store($config)->currentPath() . '/' . ReleaseStore::INVENTORY;
            $inv = is_file($f) ? json_decode((string)file_get_contents($f), true) : null;
            if (!is_array($inv)) {
                fwrite(STDERR, "No hay inventario: publica primero.\n");
                exit(1);
            }
            if (isset($opts['path'])) {
                $pg = $inv['pages'][(string)$opts['path']] ?? null;
                echo $pg === null ? "Página desconocida.\n" : implode("\n", $pg['resources']) . "\n";
                break;
            }
            echo count($inv['pages']) . " páginas; módulos: " . implode(', ', array_keys($inv['modules'])) . "\nCompartidos por todas: " . implode(', ', $inv['shared']) . "\n";
            break;

        case 'design:show':
            $sv = services($root, true);
            echo json_encode($sv->designSettings(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n";
            break;

        case 'design:set':
            // Sustituye TODOS los ajustes de diseño (global, tipos, páginas, instancias, tema, logo) por los de un JSON validado.
            $file = $pos[1] ?? '';
            $json = is_file($file) ? json_decode((string)file_get_contents($file), true) : null;
            if (!is_array($json)) {
                fwrite(STDERR, "Uso: bin/lux design:set ARCHIVO.json (ver docs/fase-5.md)\n");
                exit(1);
            }
            $sv = services($root, true);
            try {
                $norm = \LuxAeterna\Design\DesignSettings::validate($json, new \LuxAeterna\Design\DesignRegistry($root . '/components', $sv->config->path('data') . '/cache/designs.json', \LuxAeterna\Core\Version::CURRENT), new \LuxAeterna\Design\FontCatalog($root . '/components/fonts'), $root . '/components/logos');
            } catch (\InvalidArgumentException $e) {
                fwrite(STDERR, 'Ajustes no válidos: ' . $e->getMessage() . "\n");
                exit(1);
            }
            $sv->settings->set('design', json_encode($norm, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE));
            $sv->audit->log('design.save', null, 'cli', null, []);
            echo "Ajustes de diseño guardados. Se aplican en la próxima publicación.\n";
            break;

        case 'migrate':
            $sv = services($root);
            $done = (new \LuxAeterna\Core\Migrator($sv->db, $root . '/migrations'))->migrate();
            echo $done === [] ? "Base de datos al día.\n" : 'Migraciones aplicadas: ' . implode(', ', $done) . "\n";
            break;

        case 'admin:create':
            $sv = services($root, true);
            $email = $pos[1] ?? '';
            $role = is_string($opts['role'] ?? null) ? $opts['role'] : 'admin';
            $id = $sv->users->create($email, $role, is_string($opts['name'] ?? null) ? $opts['name'] : '');
            $sv->audit->log('user.create', null, 'cli', 'user:' . $id, ['role' => $role]);
            echo "Cuenta creada ($role). Abre este enlace en el navegador para fijar la contraseña (caduca en 60 min, un solo uso):\n\n  "
                . enrollLink($sv, $sv->users->byId($id), 'setup') . "\n\n";
            break;

        case 'admin:list':
            $sv = services($root, true);
            foreach ($sv->users->all() as $u) {
                printf("%-4d %-32s %-7s %-9s MFA:%s último acceso: %s\n", $u['id'], $u['email'], $u['role'], $u['status'], $u['totp_enabled'] ? 'sí' : 'no', $u['last_login_at'] ? date('Y-m-d H:i', (int)$u['last_login_at']) : '-');
            }
            break;

        case 'admin:reset':
            $sv = services($root, true);
            $u = userByEmail($sv, $pos[1] ?? '');
            $purpose = $u['status'] === 'invited' ? 'setup' : 'reset';
            $sv->audit->log('password.reset_issued', null, 'cli', 'user:' . $u['id'], ['purpose' => $purpose]);
            echo "Enlace (" . ($purpose === 'setup' ? '60' : '30') . " min, un solo uso):\n\n  " . enrollLink($sv, $u, $purpose) . "\n\n";
            break;

        case 'admin:mfa-reset':
            $sv = services($root, true);
            $u = userByEmail($sv, $pos[1] ?? '');
            $sv->users->disableTotp((int)$u['id']);
            $sv->audit->log('mfa.reset', null, 'cli', 'user:' . $u['id']);
            echo "Segundo factor desactivado y sesiones cerradas. Se pedirá configurarlo de nuevo en el próximo acceso.\n";
            break;

        case 'admin:revoke-sessions':
            $sv = services($root, true);
            if (isset($opts['all'])) {
                foreach ($sv->users->all() as $u) {
                    $sv->users->bumpEpoch((int)$u['id']);
                }
                $sv->db->run('DELETE FROM sessions');
                $sv->audit->log('session.revoke_all', null, 'cli');
                echo "Todas las sesiones cerradas.\n";
            } else {
                $u = userByEmail($sv, $pos[1] ?? '');
                $sv->users->bumpEpoch((int)$u['id']);
                $n = $sv->sessions->destroyAllForUser((int)$u['id']);
                $sv->audit->log('session.revoke_all', null, 'cli', 'user:' . $u['id']);
                echo "Sesiones cerradas: $n\n";
            }
            break;

        case 'admin:disable':
        case 'admin:enable':
            $sv = services($root, true);
            $u = userByEmail($sv, $pos[1] ?? '');
            if ($cmd === 'admin:enable' && $u['status'] === 'invited') {
                throw new LuxException('La cuenta aún no completó el alta; usa admin:reset para generar un enlace.');
            }
            $new = $cmd === 'admin:disable' ? 'disabled' : 'active';
            $sv->users->setStatus((int)$u['id'], $new);
            $sv->sessions->destroyAllForUser((int)$u['id']);
            $sv->audit->log($cmd === 'admin:disable' ? 'user.disable' : 'user.enable', null, 'cli', 'user:' . $u['id']);
            echo $new === 'disabled' ? "Cuenta desactivada.\n" : "Cuenta reactivada.\n";
            break;

        case 'admin:role':
            $sv = services($root, true);
            $u = userByEmail($sv, $pos[1] ?? '');
            $sv->users->setRole((int)$u['id'], $pos[2] ?? '');
            $sv->audit->log('user.role', null, 'cli', 'user:' . $u['id'], ['role' => $pos[2]]);
            echo "Rol actualizado y sesiones cerradas.\n";
            break;

        default:
            echo USAGE;
            exit($cmd === 'help' ? 0 : 1);
    }
} catch (LuxException $e) {
    logger($root)->error($e->getMessage(), ['detail' => $e->detail()]);
    fwrite(STDERR, 'Error: ' . $e->getMessage() . ' (operación ' . Operation::id() . ")\n");
    exit(1);
} catch (Throwable $e) {
    logger($root)->error('error interno', ['type' => get_class($e), 'msg' => $e->getMessage(), 'at' => $e->getFile() . ':' . $e->getLine()]);
    fwrite(STDERR, 'Error interno (operación ' . Operation::id() . "). El detalle está en el log privado.\n");
    exit(2);
}
