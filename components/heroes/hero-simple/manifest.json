{
  "schema": 1,
  "id": "hero-simple",
  "type": "hero",
  "name": "Hero simple",
  "version": "1.0.0",
  "description": "Título de la página y subtítulo sobre fondo de color.",
  "requires": { "lux": "0.4.0" },
  "template": "template.html",
  "css": "style.css",
  "preview": "preview.webp",
  "fields": {
    "subtitulo": { "type": "text", "label": "Subtítulo", "max": 160, "default": "" },
    "alineacion": { "type": "select", "label": "Alineación", "options": ["izquierda", "centro"], "default": "centro" },
    "altura": { "type": "select", "label": "Altura", "options": ["compacta", "media", "alta"], "default": "media" }
  },
  "resources": { "fonts": [], "images": [] }
}
